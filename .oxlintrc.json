{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    // Code smells: keep files, functions and nesting small.
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["error", { "max": 200, "skipBlankLines": true, "skipComments": true }],
    "complexity": ["error", { "max": 25 }],
    "max-depth": ["error", { "max": 4 }],
    "max-params": ["error", { "max": 4 }],
    "import/no-cycle": "error"
  },
  // Layers: imports only point inward. See docs/architecture.md.
  // Later overrides win, so the general rule comes first.
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["dexie"],
                "message": "Only the Dexie adapter (src/adapters/dexie/) imports Dexie. Screens may use dexie-react-hooks."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/application", "**/application/**", "**/adapters", "**/adapters/**"],
                "message": "domain/ must not import outer layers."
              },
              {
                "group": ["dexie", "dexie-*", "react", "react-*", "recharts"],
                "message": "domain/ must not depend on frameworks."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/adapters", "**/adapters/**"],
                "message": "application/ must not import adapters. Depend on a port instead."
              },
              {
                "group": ["dexie", "dexie-*", "react", "react-*", "recharts"],
                "message": "application/ must not depend on frameworks."
              }
            ]
          }
        ]
      }
    },
    {
      // Use-case tests run on the real Dexie store (ADR 0004), so they may import that adapter, and no other.
      "files": ["src/application/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/adapters", "**/adapters/**", "!**/adapters/dexie/dexieLogbookStore"],
                "message": "Use-case tests may import only the Dexie adapter."
              },
              {
                "group": ["dexie", "dexie-*", "react", "react-*", "recharts"],
                "message": "Reach storage through the Dexie adapter, not Dexie itself."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/adapters/dexie/**"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
